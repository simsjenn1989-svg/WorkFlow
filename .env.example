# Supabase — from your project's API settings.
# The service role key bypasses RLS and must never reach the browser. Server-side only.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Phase 2. Atlas Cloud design generation.
ATLAS_CLOUD_API_KEY=

# Phase 4. Printify draft creation. Shop ID is discoverable from the API once the token is set.
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=
