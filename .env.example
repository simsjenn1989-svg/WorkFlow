# Supabase — from your project's API settings.
# The service role key bypasses RLS and must never reach the browser. Server-side only.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Atlas Cloud design generation, and the optional print-art upscaler.
ATLAS_CLOUD_API_KEY=

# Optional. Adds Claude to the copywriting model list; Atlas writes the copy without it.
ANTHROPIC_API_KEY=

# Hard monthly ceiling on paid generation. The app refuses to go past it.
MONTHLY_BUDGET_USD=20

# Printify draft creation. Make a token at printify.com > Settings > Connections > API tokens
# with the shops.manage and uploads.write scopes. Which shop drafts go to is part of the
# product preset, read live from /v1/shops.json, so there is no shop id to set here.
PRINTIFY_API_TOKEN=

# A single shared password gates the whole app. Without it nobody can sign in — the app
# fails closed rather than open. The session cookie is signed with a key derived from this
# value, so changing it signs you out everywhere.
APP_PASSWORD=
